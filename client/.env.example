# Online Exam & Assessment Platform — client environment
# Copy to `.env` (Vite only exposes variables prefixed with VITE_).

# Base URL of the Express API. In dev the Vite proxy forwards /api, so this can
# stay as the direct server URL; the axios client falls back to relative paths.
VITE_API_URL=http://localhost:5000

# Socket.io server origin (same host as the API by default).
VITE_SOCKET_URL=http://localhost:5000

# Clerk browser publishable key (sk_...). The secret key lives server-side only.
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# Stripe publishable key (pk_...) — only used to redirect into Checkout.
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# Public app name shown in the shell / titles (overridable white-label).
VITE_APP_NAME=Exam Platform
