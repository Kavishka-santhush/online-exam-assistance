# ---------------------------------------------------------------------------
# Online Exam & Assessment Platform - API server environment
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) -------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/exam_platform
DATABASE_POOL_MAX=20
DATABASE_CONNECTION_LIMIT=5

# --- Auth (Clerk) ----------------------------------------------------------
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_WEBHOOK_SECRET=your_clerk_webhook_secret
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# --- AI (OpenRouter) -------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini
OPENROUTER_TIMEOUT_MS=120000
OPENROUTER_MAX_RETRIES=2
AI_DAILY_LIMIT_FREE=0
AI_DAILY_LIMIT_STARTER=20

# --- Payments (Stripe) -----------------------------------------------------
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_CURRENCY=usd

# --- File uploads (local Multer storage) -----------------------------------
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50
ALLOWED_IMAGE_TYPES=image/png,image/jpeg,image/webp,image/gif
ALLOWED_DOCUMENT_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel,text/csv,application/zip
ALLOWED_MEDIA_TYPES=audio/webm,audio/mpeg,audio/wav,video/webm,video/mp4

# --- Email (Nodemailer + React Email) --------------------------------------
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
MAIL_FROM_NAME=Exam Platform
MAIL_FROM_ADDRESS=no-reply@examplatform.local

# --- Server ----------------------------------------------------------------
PORT=5000
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000
NODE_ENV=development
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173

# --- Security / signing ----------------------------------------------------
CERTIFICATE_SECRET=your_certificate_signing_secret
JWT_ACCESS_SECRET=replace_with_random_64_char_string
INTERNAL_API_TOKEN=replace_with_random_service_token

# --- Code execution sandbox ------------------------------------------------
CODE_EXECUTION_TIMEOUT_MS=10000
CODE_EXECUTION_MEMORY_MB=128
CODE_EXECUTION_MAX_TESTS=20
CODE_RUNNER=isolated-vm

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_MAX=60
EXAM_SUBMIT_RATE_LIMIT_MAX=30

# --- Timer / autosave / proctoring ----------------------------------------
AUTOSAVE_INTERVAL_MS=30000
AUTO_SUBMIT_SWEEP_CRON=*/1 * * * *
REMINDER_SWEEP_CRON=*/5 * * * *
CLEANUP_SWEEP_CRON=0 3 * * *
EXAM_SCHEDULER_CRON=*/1 * * * *
VIOLATION_AUTO_TERMINATE_COUNT=8
PROCTORING_REDIS_URL=

# --- Puppeteer / PDF -------------------------------------------------------
PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox
PDF_TIMEOUT_MS=45000

# --- Feature flags ---------------------------------------------------------
ENABLE_WEBSOCKET_PROCTORING=true
ENABLE_ADAPTIVE_TESTING=true
ENABLE_LIVE_QUIZ=true
ENABLE_PUBLIC_EXAM_CATALOG=true
